# Ejecuta `npm run setup` para generar claves locales únicas en .env.
# Este archivo es documentación; no contiene credenciales utilizables.
DEMO_MODE=true
PORT=3001
APP_PORT=8080
DB_PORT=5432
POSTGRES_PASSWORD=GENERAR_CON_NPM_RUN_SETUP
APP_DB_PASSWORD=GENERAR_CON_NPM_RUN_SETUP
DATABASE_ADMIN_URL=postgresql://postgres:REEMPLAZAR@127.0.0.1:5432/centraliza
DATABASE_URL=postgresql://dashboard_app:REEMPLAZAR@127.0.0.1:5432/centraliza
JWT_SECRET=GENERAR_CON_NPM_RUN_SETUP
CREDENTIAL_ENCRYPTION_KEY=GENERAR_CON_NPM_RUN_SETUP
SHOPIFY_API_VERSION=2026-07
# Sandbox global opcional. Los prefijos mock_ y sandbox_ funcionan sin activarlo.
MOCK_PROVIDERS=false
# Solo para crear el primer Super Admin con DEMO_MODE=false.
# Rellena estos valores en .env local y elimínalos después del bootstrap.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
